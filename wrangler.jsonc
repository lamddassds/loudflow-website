// Cloudflare Worker for loudflow.ai — replaces the Vercel project (2026-10-02).
// Deploy: `npm run cf:deploy`. The code is worker/index.ts; it reuses lib/ and
// app/api/google-token/route.ts unchanged.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loudflow-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // lib/authdone.ts hashes its script with node's crypto, and the google-token
  // route reads process.env.GOOGLE_CLIENT_SECRET — both need this flag
  // (process.env is filled from the Worker's secrets since 2025-04-01).
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  "workers_dev": true,
  // Every host lands on this Worker; worker/index.ts answers loudflow.ai and
  // 301s the rest to it. Custom domains create their own DNS record and
  // certificate, so a hostname here must have NO other record in its zone.
  "routes": [
    { "pattern": "loudflow.ai", "custom_domain": true },
    { "pattern": "www.loudflow.ai", "custom_domain": true },
    { "pattern": "loudflow.si", "custom_domain": true },
    { "pattern": "www.loudflow.si", "custom_domain": true },
    // loudflow.xyz is a ROUTE, not a custom domain, on purpose: its two DNS
    // records (A 216.198.79.1, www CNAME cname.vercel-dns.com) stay and are
    // switched to "Proxied", so the moment they flip the Worker answers and
    // there is no instant without a record. A custom domain would have needed
    // the records deleted first, and a resolver asking in that gap caches "no
    // such name" for the SOA minimum. History, measured 2026-10-02: the .xyz
    // registry switched 13:30:51, zone active 13:33:51, and in between the
    // custom domain answered with the bare placeholder AAAA 100:: — loudflow.xyz
    // was unreachable for a few minutes. .ai went active 15:40:08, HTTPS 15:42.
    // The zone also carries the Resend sign-in mail records (send CNAME,
    // resend._domainkey, _dmarc) — untouched.
    { "pattern": "loudflow.xyz/*", "zone_name": "loudflow.xyz" },
    { "pattern": "www.loudflow.xyz/*", "zone_name": "loudflow.xyz" }
  ]
}
