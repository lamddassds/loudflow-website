// Cloudflare Worker for loudflow.ai — replaces the Vercel project (2026-10-02).
// Deploy: `npm run cf:deploy`. The code is worker/index.ts; it reuses lib/ and
// app/api/google-token/route.ts unchanged.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loudflow-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // lib/authdone.ts hashes its script with node's crypto, and the google-token
  // route reads process.env.GOOGLE_CLIENT_SECRET — both need this flag
  // (process.env is filled from the Worker's secrets since 2025-04-01).
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  "workers_dev": true,
  // Every host lands on this Worker; worker/index.ts answers loudflow.ai and
  // 301s the rest to it. Custom domains create their own DNS record and
  // certificate, so a hostname here must have NO other record in its zone.
  "routes": [
    { "pattern": "loudflow.ai", "custom_domain": true },
    { "pattern": "www.loudflow.ai", "custom_domain": true },
    { "pattern": "loudflow.si", "custom_domain": true },
    { "pattern": "www.loudflow.si", "custom_domain": true }
    // loudflow.xyz + www.loudflow.xyz come back here once loudflow.ai is ACTIVE
    // on Cloudflare — xyz 301s to .ai, and installs up to 0.3.79 sign in through
    // loudflow.xyz/auth/done, so .ai has to answer first. Measured 2026-10-02:
    // the .xyz registry switched at 13:30:51; until the zone turned active
    // (13:33:51, after "Check nameservers now") Cloudflare answered the custom
    // domain with the bare placeholder AAAA 100::, i.e. unreachable. Until .ai
    // is active the zone points loudflow.xyz at Vercel (A 216.198.79.1 and www
    // CNAME cname.vercel-dns.com, both DNS only). The zone also carries the
    // Resend sign-in mail records (send CNAME, resend._domainkey, _dmarc).
  ]
}
